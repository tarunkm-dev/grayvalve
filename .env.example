# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API. Use the *publishable* key, never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public site URL, used for auth email redirects (e.g. https://grayvalve.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: where the "Download for Android" buttons point (Play Store listing or a signed APK).
# Leave empty to show the beta sign-up instead.
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=
